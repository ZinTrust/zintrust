FROM zintrust/zintrust@sha256:dc80ab1e89e83c258dda163a6672d5e216c30da24aead76bc799e6bb59c08f1b AS runtime

WORKDIR /app

ENV NODE_ENV=production
ENV PORT=7772
ENV HOST=0.0.0.0

USER nodejs

HEALTHCHECK --interval=30s --timeout=10s --start-period=5s --retries=3 \
  CMD node -e "require('node:http').get('http://localhost:7772/health', (r) => {if (r.statusCode !== 200) throw new Error(r.statusCode)})"

EXPOSE 7772

CMD ["node", "dist/src/boot/bootstrap.js"]
