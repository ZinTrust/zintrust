/**
 * ============================================================================
 * ZinTrust SMTP Proxy (Local)
 * ============================================================================
 * Local-only Wrangler config for the SMTP proxy container.
 * ============================================================================
 */

{
  "name": "zintrust-smtp-proxy-local",
  "main": "./src/containers-proxy.ts",

  "compatibility_date": "2025-04-21",
  "compatibility_flags": ["nodejs_compat"],

  "workers_dev": true,
  "minify": false,

  "containers": [
    {
      "class_name": "ZintrustSmtpProxyContainer",
      "image": "./Dockerfile.smtp.local",
      "image_build_context": ".",
      "max_instances": 10
    }
  ],

  "durable_objects": {
    "bindings": [
      { "name": "ZT_PROXY_SMTP", "class_name": "ZintrustSmtpProxyContainer" }
    ]
  },

  "migrations": [
    {
      "tag": "smtp-proxy-local-v1",
      "new_sqlite_classes": ["ZintrustSmtpProxyContainer"]
    }
  ]
}
