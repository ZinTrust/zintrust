/**
 * ============================================================================
 * ZinTrust Redis Proxy (Local)
 * ============================================================================
 * Local-only Wrangler config for the Redis proxy container.
 * ============================================================================
 */

{
  "name": "zintrust-redis-proxy-local",
  "main": "./src/containers-proxy.ts",

  "compatibility_date": "2025-04-21",
  "compatibility_flags": ["nodejs_compat"],

  "workers_dev": true,
  "minify": false,

  "containers": [
    {
      "class_name": "ZintrustRedisProxyContainer",
      "image": "./Dockerfile.redis.local",
      "image_build_context": ".",
      "max_instances": 10
    }
  ],

  "durable_objects": {
    "bindings": [
      { "name": "ZT_PROXY_REDIS", "class_name": "ZintrustRedisProxyContainer" }
    ]
  },

  "migrations": [
    {
      "tag": "redis-proxy-local-v1",
      "new_sqlite_classes": ["ZintrustRedisProxyContainer"]
    }
  ]
}
