{
  "name": "@zintrust/queue-cloudflare",
  "version": "2.8.8",
  "description": "Cloudflare Queues driver for ZinTrust.",
  "private": false,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./register": {
      "types": "./dist/register.d.ts",
      "default": "./dist/register.js"
    },
    "./cli-register": {
      "types": "./dist/cli-register.d.ts",
      "default": "./dist/cli-register.js"
    },
    "./migrations": {
      "types": "./dist/migrations/index.d.ts",
      "default": "./dist/migrations/index.js"
    }
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "peerDependencies": {
    "@zintrust/core": "*"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "zintrust",
    "queue",
    "cloudflare",
    "cloudflare-queues",
    "workers",
    "adapter"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && tsc -p tsconfig.migrations.json && node ../../scripts/fix-dist-esm-imports.mjs dist",
    "prepublishOnly": "npm run build"
  }
}
