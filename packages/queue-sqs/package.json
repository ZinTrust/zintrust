{
  "name": "@zintrust/queue-sqs",
  "version": "3.0.0",
  "description": "Amazon SQS queue driver for ZinTrust.",
  "private": false,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./register": {
      "types": "./dist/register.d.ts",
      "default": "./dist/register.js"
    }
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "@aws-sdk/client-sqs": "^3.1121.0"
  },
  "overrides": {
    "fast-xml-parser": "5.8.0",
    "flatted": "^3.4.2",
    "uuid": "14.0.0"
  },
  "peerDependencies": {
    "@zintrust/core": "*"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "zintrust",
    "queue",
    "aws",
    "sqs",
    "adapter"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepublishOnly": "npm run build"
  }
}
