{
  "name": "@zintrust/queue-monitor",
  "version": "3.1.0",
  "description": "Queue monitoring package for ZinTrust with BullMQ and Redis.",
  "private": false,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "src/config"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./runtime": {
      "types": "./dist/runtime-index.d.ts",
      "default": "./dist/runtime-index.js"
    },
    "./driver": {
      "types": "./dist/driver-index.d.ts",
      "default": "./dist/driver-index.js"
    },
    "./metrics": {
      "types": "./dist/metrics-index.d.ts",
      "default": "./dist/metrics-index.js"
    },
    "./dashboard": {
      "types": "./dist/dashboard-index.d.ts",
      "default": "./dist/dashboard-index.js"
    }
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "peerDependencies": {
    "@zintrust/core": "*",
    "@zintrust/redis-rpc": "*"
  },
  "peerDependenciesMeta": {
    "@zintrust/redis-rpc": {
      "optional": true
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "zintrust",
    "queue",
    "monitoring",
    "redis",
    "bullmq"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "bullmq": "^5.77.6",
    "ioredis": "^5.11.0"
  }
}
