{
  "name": "@zintrust/queue-monitor",
  "version": "0.5.5",
  "description": "Queue monitoring package for ZinTrust with BullMQ and Redis.",
  "private": false,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "src/config"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "peerDependencies": {
    "@zintrust/core": "^0.5.2"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "zintrust",
    "queue",
    "monitoring",
    "redis",
    "bullmq"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "bullmq": "^5.73.0",
    "ioredis": "^5.10.1"
  }
}
