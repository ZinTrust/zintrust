{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "lib": ["es2023", "dom", "esnext.disposable"],
    "paths": {},
    "rootDir": "./src",
    "outDir": "./dist",
    "declaration": true,
    "declarationMap": false,
    "sourceMap": false,
    "composite": false,
    "types": ["node"],
    "tsBuildInfoFile": "./dist/.tsbuildinfo"
  },
  "include": ["src/**/*.ts"],
  "exclude": ["node_modules", "dist", "migrations"]
}
