{
  "name": "@zintrust/trace",
  "version": "2.1.0",
  "description": "Trace assistant for ZinTrust: logs requests, queries, exceptions, jobs, and more.",
  "private": false,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./ui": {
      "types": "./dist/ui.d.ts",
      "default": "./dist/ui.js"
    },
    "./cli-register": {
      "types": "./dist/cli-register.d.ts",
      "default": "./dist/cli-register.js"
    },
    "./plugin": {
      "types": "./dist/plugin.d.ts",
      "default": "./dist/plugin.js"
    },
    "./register": {
      "types": "./dist/register.d.ts",
      "default": "./dist/register.js"
    },
    "./migrations": {
      "types": "./dist/migrations/index.d.ts",
      "default": "./dist/migrations/index.js"
    }
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "peerDependencies": {
    "@zintrust/core": "*"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "zintrust",
    "trace",
    "observability",
    "tracing",
    "telescope"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && tsc -p tsconfig.migrations.json && node ../../scripts/fix-dist-esm-imports.mjs dist",
    "prepublishOnly": "npm run build"
  }
}
