{
  "name": "@zintrust/d1-migrator",
  "version": "0.4.78",
  "description": "Resumable database migration toolkit for moving data to Cloudflare D1 with ZinTrust.",
  "private": false,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./register": {
      "types": "./dist/register.d.ts",
      "default": "./dist/register.js"
    }
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "peerDependencies": {
    "@zintrust/core": "^0.4.77"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "zintrust",
    "cloudflare",
    "d1",
    "migration",
    "database"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && node ../../scripts/fix-dist-esm-imports.mjs dist",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@zintrust/db-mysql": "file:../../packages/db-mysql",
    "@zintrust/db-postgres": "file:../../packages/db-postgres",
    "@zintrust/db-sqlite": "file:../../packages/db-sqlite",
    "@zintrust/db-sqlserver": "file:../../packages/db-sqlserver",
    "@zintrust/db-d1": "file:../../packages/db-d1"
  }
}
