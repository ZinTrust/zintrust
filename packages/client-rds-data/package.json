{
  "name": "@zintrust/client-rds-data",
  "version": "0.9.2",
  "description": "AWS RDS Data API and Secrets Manager helpers for ZinTrust.",
  "private": false,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "@aws-sdk/client-rds-data": "3.893.0",
    "@aws-sdk/client-secrets-manager": "3.893.0"
  },
  "peerDependencies": {
    "@zintrust/core": "^0.9.2"
  },
  "overrides": {
    "fast-xml-parser": "^5.7.1",
    "flatted": "^3.4.2",
    "@aws-sdk/xml-builder": {
      "fast-xml-parser": "^5.7.1"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "zintrust",
    "aws",
    "rds-data",
    "aurora",
    "typescript"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepublishOnly": "npm run build"
  }
}
