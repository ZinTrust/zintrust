{
  "name": "@zintrust/client-rds-data",
  "version": "0.8.0",
  "description": "AWS RDS Data API and Secrets Manager helpers for ZinTrust.",
  "private": false,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "@aws-sdk/client-rds-data": "^3.1025.0",
    "@aws-sdk/client-secrets-manager": "^3.1025.0"
  },
  "peerDependencies": {
    "@zintrust/core": "^0.7.0"
  },
  "overrides": {
    "fast-xml-parser": "^5.5.7",
    "flatted": "^3.4.2"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "zintrust",
    "aws",
    "rds-data",
    "aurora",
    "typescript"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepublishOnly": "npm run build"
  }
}
