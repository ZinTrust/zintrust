{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ES2022",
    "lib": ["es2023", "dom", "esnext.disposable"],
    "moduleResolution": "bundler",
    "rootDir": "./src",
    "outDir": "./dist",
    "declaration": true,
    "declarationMap": false,
    "sourceMap": false,
    "composite": false,
    "skipLibCheck": true,
    "types": ["node"],
    "tsBuildInfoFile": "./dist/.tsbuildinfo",
    "paths": {
      "@zintrust/queue-monitor": ["../queue-monitor/dist/index.d.ts"],
      "@zintrust/queue-redis": ["../queue-redis/dist/index.d.ts"]
    }
  },
  "include": ["src/**/*.ts", "src/**/*.d.ts", "src/types/queue-monitor.d"],
  "exclude": ["node_modules", "dist", "tests"]
}
