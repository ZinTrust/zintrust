{
  "name": "@zintrust/workers",
  "version": "0.7.1",
  "description": "Worker orchestration and background job management for ZinTrust.",
  "private": false,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "src"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./register": {
      "types": "./dist/register.d.ts",
      "default": "./dist/register.js"
    },
    "./HealthMonitor": {
      "types": "./dist/HealthMonitor.d.ts",
      "default": "./dist/HealthMonitor.js"
    },
    "./ResourceMonitor": {
      "types": "./dist/ResourceMonitor.d.ts",
      "default": "./dist/ResourceMonitor.js"
    },
    "./telemetry": {
      "types": "./telemetry/dist/index.d.ts",
      "default": "./telemetry/dist/index.js"
    },
    "./telemetry/*": {
      "types": "./telemetry/dist/*.d.ts",
      "default": "./telemetry/dist/*.js"
    }
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "peerDependencies": {
    "@zintrust/core": ">=0.7.0 <0.8.0",
    "@zintrust/queue-monitor": "^0.7.0",
    "@zintrust/queue-redis": "^0.7.0"
  },
  "peerDependenciesMeta": {
    "@zintrust/queue-monitor": {
      "optional": true
    },
    "@zintrust/queue-redis": {
      "optional": true
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "zintrust",
    "workers",
    "jobs",
    "queue",
    "orchestration"
  ],
  "scripts": {
    "build": "node scripts/generate-embedded-assets.mjs && tsc -p tsconfig.json && node ../../scripts/fix-dist-esm-imports.mjs dist",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@opentelemetry/api": "^1.9.1",
    "hot-shots": "^14.3.1",
    "ioredis": "^5.10.1",
    "prom-client": "^15.1.3",
    "simple-statistics": "^7.8.9"
  }
}
