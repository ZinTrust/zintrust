{
  "name": "@zintrust/governance",
  "version": "3.0.0",
  "description": "ESLint and governance tooling package for ZinTrust.",
  "private": false,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./eslint": {
      "types": "./dist/eslint.d.ts",
      "default": "./dist/eslint.js"
    }
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "peerDependencies": {
    "@zintrust/core": "*",
    "eslint": "^10.9.1",
    "typescript": ">=5.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "zintrust",
    "governance",
    "compliance",
    "eslint",
    "typescript"
  ],
  "dependencies": {
    "@eslint/js": "^10.0.1",
    "brace-expansion": "^5.0.9",
    "globals": "^17.11.0",
    "typescript-eslint": "^8.68.0"
  },
  "overrides": {
    "ajv": "^8.18.0",
    "@eslint/plugin-kit": "^0.7.1",
    "flatted": "^3.4.2",
    "minimatch": "^10.2.2",
    "brace-expansion": "^5.0.9",
    "picomatch": "^4.0.4",
    "tmp": "^0.2.6"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepublishOnly": "npm run build"
  }
}
