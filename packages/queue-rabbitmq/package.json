{
  "name": "@zintrust/queue-rabbitmq",
  "version": "0.8.0",
  "description": "RabbitMQ queue driver for ZinTrust.",
  "private": false,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./register": {
      "types": "./dist/register.d.ts",
      "default": "./dist/register.js"
    }
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "amqplib": "^1.0.3"
  },
  "peerDependencies": {
    "@zintrust/core": "*"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "zintrust",
    "queue",
    "rabbitmq",
    "amqp",
    "adapter"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepublishOnly": "npm run build"
  }
}
