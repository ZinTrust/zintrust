  },
  "files": [
    "bin",
    "src",
    "public",
    "index.js",
    "index.d.ts"
  ],
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=9.0.0"
  },
  "scripts": {
    "worker-plugins:ensure": "node scripts/ensure-worker-plugins.mjs",
    "ci:remove-dev-routes": "node scripts/toggle-dev-routes.mjs remove",
    "ci:coverage-prep": "node -e \"if (process.env.CI==='true' || process.env.CI==='1') require('node:child_process').execSync('node scripts/toggle-dev-routes.mjs remove', { stdio: 'inherit' })\"",
    "clean": "rm -rf dist",
    "core:link-dist": "mkdir -p node_modules/@zintrust && rm -rf node_modules/@zintrust/core && ln -s ../../dist node_modules/@zintrust/core && ls -la node_modules/@zintrust/core && cat node_modules/@zintrust/core/package.json | head -n 8",
    "prebuild": "npm run -s worker-plugins:ensure && node scripts/toggle-dev-routes.mjs comment && node scripts/clean-src-emit.mjs",
    "build": "npm run clean && npm run templates:check && tsc && tsc-alias && node scripts/rewrite-dist-tsconfig-aliases.mjs && node scripts/fix-dist-esm-imports.mjs && node scripts/fix-worker-aliases.mjs && node scripts/copy-cli-templates-to-dist.mjs && node scripts/copy-getting-started-to-dist-readme.mjs && node scripts/copy-docs-public-to-dist.mjs && node scripts/generate-dist-package.mjs && node scripts/replace-build-placeholders.mjs && node scripts/add-version-banner.mjs && node scripts/generate-build-manifest.mjs && npm run packages:build:all",
    "core:build:dist": "npm run -s worker-plugins:ensure && npm run clean && npm run templates:check && tsc && tsc-alias && node scripts/rewrite-dist-tsconfig-aliases.mjs && node scripts/fix-dist-esm-imports.mjs && node scripts/fix-worker-aliases.mjs && node scripts/copy-cli-templates-to-dist.mjs && node scripts/copy-getting-started-to-dist-readme.mjs && node scripts/copy-docs-public-to-dist.mjs && node scripts/generate-dist-package.mjs && node scripts/replace-build-placeholders.mjs && node scripts/add-version-banner.mjs && node scripts/generate-build-manifest.mjs",
    "postbuild": "node scripts/toggle-dev-routes.mjs uncomment",
    "build:ci": "export CI=true && npm run -s ci:remove-dev-routes && npm run clean && npm run templates:check && tsc && tsc-alias && node scripts/rewrite-dist-tsconfig-aliases.mjs && node scripts/copy-docs-public-to-dist.mjs && node scripts/fix-dist-esm-imports.mjs && node scripts/fix-worker-aliases.mjs && node scripts/generate-dist-package.mjs && node scripts/replace-build-placeholders.mjs && node scripts/add-version-banner.mjs && node scripts/generate-build-manifest.mjs && npm run packages:build:all",
    "build:dk": "export CI=true && npm run -s ci:remove-dev-routes && npm run clean && npm run templates:check && npm run packages:build:docker && tsc && tsc-alias && node scripts/rewrite-dist-tsconfig-aliases.mjs && node scripts/copy-docs-public-to-dist.mjs && node scripts/fix-dist-esm-imports.mjs && node scripts/fix-worker-aliases.mjs && node scripts/generate-dist-package.mjs && node scripts/replace-build-placeholders.mjs && node scripts/add-version-banner.mjs && node scripts/generate-build-manifest.mjs",
    "prebuild:ci": "npm run -s worker-plugins:ensure && npm run -s ci:remove-dev-routes",
    "prepro:build": "npm run -s worker-plugins:ensure && node scripts/toggle-dev-routes.mjs comment",
    "pro:build": "npm run clean && npm test && npm run templates:check && tsc && tsc-alias && node scripts/rewrite-dist-tsconfig-aliases.mjs && node scripts/fix-dist-esm-imports.mjs && node scripts/fix-worker-aliases.mjs && node scripts/copy-docs-public-to-dist.mjs && node scripts/copy-cli-templates-to-dist.mjs && node scripts/copy-getting-started-to-dist-readme.mjs && node scripts/generate-dist-package.mjs && node scripts/replace-build-placeholders.mjs && node scripts/add-version-banner.mjs && node scripts/generate-build-manifest.mjs && npm run packages:build:all",
    "watch": "tsc --watch --noEmit",
    "pretest": "npm run -s worker-plugins:ensure && node scripts/ci/ensure-eslint-ajv8.mjs",
    "test": "vitest run",
    "test:workers": "vitest run tests/workers",
    "test:watch": "vitest",
    "pretest:coverage": "npm run -s worker-plugins:ensure && node scripts/ci/ensure-eslint-ajv8.mjs && npm run -s ci:coverage-prep",
    "test:coverage": "vitest run --coverage",
    "coverage:diff": "tsx scripts/coverage-diff.ts",
    "coverage:patch": "sh scripts/coverage-patch.sh",
    "lint": "node scripts/ci/ensure-eslint-ajv8.mjs && eslint \"src/**/*.ts\" \"app/**/*.ts\" \"routes/**/*.ts\" \"packages/**/*.ts\" \"tests/**/*.ts\" \"bin/**/*.ts\" \"database/**/*.ts\"",
    "lint:strict": "npm run lint -- --max-warnings=0",
    "format": "prettier --write 'src/**/*.ts'",
    "packages:build": "node scripts/build-all-packages.mjs",
    "packages:build:all": "node scripts/build-all-packages.mjs --all",
    "packages:build:docker": "node scripts/build-all-packages.mjs --all --exclude d1-migrator",
    "dev": "./bin/z.ts s",
    "idea": "npm --prefix ideas run deploy",
    "idea:dry-run": "npm --prefix ideas run deploy:dry-run",
    "idea:dev": "npm --prefix ideas run dev",
    "deploy": "npm run dbl && node scripts/run-local-wrangler.mjs --cwd docs-website -- wrangler types && node scripts/run-local-wrangler.mjs --cwd docs-website -- wrangler deploy --env ${WRANGLER_ENV:-production}",
    "deploy:wk": "wrangler deploy --env worker",
    "deploy:d1": "wrangler deploy --env d1-proxy",
    "deploy:kv": "wrangler deploy --env kv-proxy",
    "deploy:cp": "./bin/z.ts deploy:ccp",
    "dev:cp": "node scripts/dev-cp.mjs",
    "dev:cp:clean": "node scripts/dev-cp.mjs --clean-images",
    "dev:cp:build": "npm run dev:cp -- --pull",
    "dev:cp:pull": "npm run dev:cp -- --pull",
    "dev:d1": "wrangler dev --env d1-proxy",
    "dev:kv": "wrangler dev --env kv-proxy",
    "templates:sync": "npm run templates:check && node -e \"console.log('templates:sync is disabled for now (no auto-updates). Update src/templates manually.');\"",
    "templates:check": "tsx src/scripts/TemplateImportsCheck.ts",
    "env:generate": "tsx src/scripts/GenerateEnvArtifacts.ts",
    "git-reload": "git rm -r --cached .  && git add .",
    "start": "node dist/src/bootstrap.js",
    "pretype-check": "npm run -s worker-plugins:ensure",
    "type-check": "tsc --noEmit -p tsconfig.json",
    "test:sonar": "npm run -s ci:coverage-prep && vitest run --coverage && tsx dev/sonar-scan.ts",
    "sonarqube": "tsx dev/sonar-scan.ts",
    "sonarqube:setup": "node dev/sonarqube-setup.js",
    "sonarcloud:issues": "tsx dev/sonarcloud-issues.ts",
    "sonarcloud:issues:low": "tsx dev/sonarcloud-issues.ts --low --open",
    "sonarcloud:issues:measures": "tsx dev/sonarcloud-issues.ts --measures",
    "sonarcloud:check": "bash dev/sonarcloud-check.sh",
    "update": "node dev/update-deps.mjs",
    "docker:build": "docker build --target runtime -t zintrust:latest .",
    "docker:build:prod": "docker build -t zintrust:latest --target runtime .",
    "docker:build:worker": "docker build --target worker -t zintrust-worker:latest .",
    "docker:push": "./bin/z.ts docker push --only runtime",
    "docker:smoke": "node scripts/docker-image-smoke.mjs base && node scripts/docker-image-smoke.mjs worker",
    "docker:smoke:base": "node scripts/docker-image-smoke.mjs base",
    "docker:smoke:worker": "node scripts/docker-image-smoke.mjs worker",
    "docker:prune": "docker system prune -a --volumes --force",
    "docker:up": "docker-compose up -d",
    "docker:down": "docker-compose down",
    "docker:stop": "docker-compose stop",
    "docker:logs": "docker-compose logs -f app",
    "docker:shell": "docker-compose run --rm app sh",
    "docker:test": "docker-compose exec app npm test",
    "docker:migrate": "docker-compose exec app node dist/bootstrap.js migrate",
    "microservices:generate": "tsx bin/zintrust-microservices.ts generate",
    "microservices:bundle": "tsx bin/zintrust-microservices.ts bundle",
    "microservices:docker": "tsx bin/zintrust-microservices.ts docker",
    "microservices:discover": "tsx bin/zintrust-microservices.ts discover",
    "microservices:status": "tsx bin/zintrust-microservices.ts status",
    "microservices:health": "tsx bin/zintrust-microservices.ts health",
    "docs:dev:vue": "cd docs-website/vue && npm run dev",
    "docs:dev": "node scripts/docs-website-dev.mjs --port 7030",
    "docs:build:vue": "mkdir -p docs-website/vue/public && cp docs-website/zintrust.svg docs-website/vue/public/ && cp docs/*.md docs-website/vue/ && cd docs-website/vue && npm run build && cp -R .vitepress/dist/* ../public/",
    "docs:build:portal": "node scripts/docs-build-portal.mjs",
    "docs:build:all": "rm -rf docs-website/public && npm run docs:build:portal && npm run docs:build:vue",
    "docs:brand:png": "node scripts/convert-brand-svgs-to-png.mjs --input docs-website/brand --max 2048",
    "dbl": "npm run docs:build:all",
    "zintrust:prepare": "tsx bin/zintrust.ts prepare",
    "ecommerce:up": "cd services/ecommerce && docker-compose up -d",
    "ecommerce:down": "cd services/ecommerce && docker-compose down",
    "ecommerce:logs": "cd services/ecommerce && docker-compose logs -f",
    "cleanup:github-actions": "bash ./dev/cleanup-github-actions.sh",
    "commemtout": "bash ./scripts/disable-plugins-import.sh",
    "duplication:check": "node scripts/ci/duplication-check.mjs",
    "prepare": "node -e \"const omit=(process.env.npm_config_omit||'').split(',').map(s=>s.trim()).filter(Boolean); const skip=process.env.NODE_ENV==='production'||process.env.CI==='true'||process.env.CI==='1'||omit.includes('dev'); process.exit(skip?0:1)\" || husky",
    "prepublishOnly": "npm run core:build:dist",
    "postinstall": "node -e \"process.exit(0)\"",
    "check-up": "npx npm-check-updates -u && npm install --no-audit --no-fund",
    "check-up:check": "npx npm-check-updates",
    "pub": "npm run core:build:dist && npm publish ./dist --access public",
    "pub:ci": "npm run release:update-deps && npm run core:build:dist && npm publish ./dist --access public",
    "push:docker": "npm run docker:push --",
    "rebuild:bcrypt": "npm rebuild bcrypt",
    "rebuild:native": "npm rebuild bcrypt better-sqlite3",
    "b:push": "npm run lint:strict",
    "bg": "npm install -g /opt/homebrew/var/www/Sites/zintrust/dist",
    "check:workspace-versions": "node scripts/release/sync-package-versions.mjs --check",
    "release:sync-versions": "node scripts/release/sync-package-versions.mjs",
    "release:update-deps": "npx npm-check-updates -u && npm install --no-audit --no-fund",
    "release:publish-packages": "npm run release:update-deps && node scripts/release/publish-packages.mjs",
    "release:publish-all": "npm run release:update-deps && npm run pub:ci && node scripts/release/publish-packages.mjs --verify-core-on-npm",
    "cag": "npm run cleanup:github-actions",
    "core": "npm run core:build:dist",
    "prewg": "npm run -s worker-plugins:ensure",
    "wg": "zin s --wg --env development"
  },
  "lint-staged": {
    "src/**/*.ts": [
      "node scripts/ci/ensure-eslint-ajv8.mjs",
      "eslint --fix"
    ]
  },
