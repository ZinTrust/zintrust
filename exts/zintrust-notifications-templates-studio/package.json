{
  "name": "zintrust-notifications-templates-studio",
  "displayName": "ZinTrust Notifications + Templates Studio",
  "description": "Mail, notification, and markdown template tooling for ZinTrust projects.",
  "version": "0.0.1",
  "publisher": "zintrust",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/ZinTrust/zintrust.git",
    "directory": "exts/zintrust-notifications-templates-studio"
  },
  "engines": {
    "vscode": "^1.95.0"
  },
  "categories": [
    "Other"
  ],
  "main": "./out/extension.js",
  "files": [
    "out/**",
    "package.json",
    "README.md",
    "LICENSE.md"
  ],
  "contributes": {
    "commands": [
      {
        "command": "zintrustTemplates.createTemplate",
        "title": "ZinTrust Templates: Create Template"
      },
      {
        "command": "zintrustTemplates.previewTemplate",
        "title": "ZinTrust Templates: Preview Template"
      }
    ]
  },
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "package": "vsce package --no-dependencies"
  },
  "homepage": "https://github.com/ZinTrust/zintrust/tree/master/exts/zintrust-notifications-templates-studio",
  "bugs": {
    "url": "https://github.com/ZinTrust/zintrust/issues"
  }
}
