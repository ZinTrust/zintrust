{
  "name": "zintrust-vscode-extensions",
  "private": true,
  "version": "0.0.1",
  "description": "VS Code extension workspace for ZinTrust developer tooling.",
  "workspaces": [
    "zintrust-*"
  ],
  "scripts": {
    "compile": "npm run compile --workspaces --if-present",
    "watch": "npm run watch --workspaces --if-present",
    "package": "npm run package --workspaces --if-present",
    "test": "npm run compile && node ./scripts/test-extensions.mjs && node ./scripts/test-extension-behaviors.mjs",
    "validate": "node ./scripts/validate-workspaces.mjs && node ./scripts/validate-release-metadata.mjs",
    "release:artifacts": "npm run validate && node ./scripts/collect-vsix-artifacts.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.19.21",
    "@types/vscode": "^1.125.0",
    "@vscode/vsce": "^3.9.2",
    "typescript": "^5.9.3"
  },
  "overrides": {
    "qs": "^6.15.2",
    "brace-expansion": "^5.0.6",
    "form-data": "^4.0.6",
    "js-yaml": "^4.2.0",
    "markdown-it": "^14.1.2",
    "tmp": "^0.2.7",
    "undici": "^7.28.0"
  }
}
