{
  "name": "zintrust-project-doctor",
  "displayName": "ZinTrust Project Doctor",
  "description": "Startup, config, package, and runtime diagnostics for ZinTrust projects.",
  "version": "0.0.1",
  "publisher": "zintrust",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/ZinTrust/zintrust.git",
    "directory": "exts/zintrust-project-doctor"
  },
  "engines": {
    "vscode": "^1.95.0"
  },
  "categories": [
    "Other"
  ],
  "main": "./out/extension.js",
  "files": [
    "out/**",
    "package.json",
    "README.md",
    "LICENSE.md"
  ],
  "contributes": {
    "commands": [
      {
        "command": "zintrustDoctor.runChecks",
        "title": "ZinTrust Doctor: Run Checks"
      },
      {
        "command": "zintrustDoctor.explainFailure",
        "title": "ZinTrust Doctor: Explain Failure"
      }
    ]
  },
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "package": "vsce package --no-dependencies"
  },
  "homepage": "https://github.com/ZinTrust/zintrust/tree/master/exts/zintrust-project-doctor",
  "bugs": {
    "url": "https://github.com/ZinTrust/zintrust/issues"
  }
}
